{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "@mohak34/opencode-notifier@latest",
    "opencode-parser"
  ],
  "mcp": {
    "grafana-staging": {
      "type": "local",
      "command": ["mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "https://monitoring-cluster.individualreisen.check24-test.de/",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "TODO",
        "GRAFANA_ORG_ID": "1"
      }
    },
    "grafana-production": {
      "type": "local",
      "command": ["mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "https://monitoring-cluster.individualreisen.check24.de/",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "TODO",
        "GRAFANA_ORG_ID": "1"
      }
    },
    "grafana-local": {
      "type": "local",
      "command": ["mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "http://lgtm.lgtm.orb.local",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "TODO",
        "GRAFANA_ORG_ID": "1"
      }
    },
    "grafana-local-cms": {
      "type": "local",
      "command": ["mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "http://lgtm.lgtm.orb.local",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "TODO",
        "GRAFANA_ORG_ID": "1"
      }
    }
  }
}
